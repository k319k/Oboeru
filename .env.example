# Groq API キー（音声文字起こし用）
# 取得方法: https://console.groq.com/ の API Keys から作成
# このファイルを .env にコピーして値を設定してください
GROQ_API_KEY=

# OpenRouter API キー（読み上げ TTS と Jev 意味一致判定で共有）
# 取得方法: https://openrouter.ai/ に登録し、Credits で入金してから Keys で作成
# 従量課金: TTS は 10 秒あたり $0.0015（1 文あたり約 $0.002〜0.005）。生成済み音声は
# IndexedDB にキャッシュされるので、同じ文を再練習しても再請求は起きません
OPENROUTER_API_KEY=