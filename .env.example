# Groq API キー（音声文字起こし用）
# 取得方法: https://console.groq.com/ の API Keys から作成
# このファイルを .env にコピーして値を設定してください
GROQ_API_KEY=

# Google Cloud Text-to-Speech API キー（音声読み上げ用）
# 取得方法: https://console.cloud.google.com/ で TTS API を有効化し、API キーを作成
# 無料枠: Neural2 音声は月 100万文字（超過時 $16/100万文字・2026-09 公式確認）
GOOGLE_TTS_API_KEY=